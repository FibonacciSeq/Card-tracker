# Optional. Leave unset when using Expo Go on the same LAN as the API: the app
# derives the host from the Expo dev server and assumes port 8000.
#
# On web the app auto-detects VS Code port forwarding: a page served from
# https://{tunnelId}-{port}.{region}.devtunnels.ms calls the API at the same
# host with the port segment swapped to 8000, provided port 8000 is forwarded
# in the same VS Code window. Forwarded URLs need no env var.
#
# Set this for production builds, for other tunnels, or when the API is not on
# the Metro host (a VS Code tunnel id changes per session):
# EXPO_PUBLIC_API_BASE_URL=https://rx0s4th0-8000.euw.devtunnels.ms/
