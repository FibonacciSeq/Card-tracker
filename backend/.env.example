CARDTRACKER_ENVIRONMENT=development
CARDTRACKER_DATABASE_URL=postgresql+psycopg://cardtracker_app:cardtracker_app@db:5432/cardtracker
# Owner role for Alembic only; the runtime URLs above must be non-owner so RLS applies.
CARDTRACKER_MIGRATION_DATABASE_URL=postgresql+psycopg://cardtracker_owner:cardtracker_owner@db:5432/cardtracker
CARDTRACKER_JWT_SECRET=replace-with-at-least-32-random-characters
CARDTRACKER_AUTO_CREATE_TABLES=false
CARDTRACKER_DEFAULT_HOLD_HOURS=24
CARDTRACKER_CORS_ORIGINS=*
# Notification delivery: console (redacted subject only, default), smtp, or none.
# `none` leaves queued mail pending; it does not mark messages as sent.
CARDTRACKER_NOTIFICATION_BACKEND=console
CARDTRACKER_NOTIFICATION_MAX_ATTEMPTS=8
# Required when CARDTRACKER_NOTIFICATION_BACKEND=smtp
# CARDTRACKER_SMTP_HOST=smtp.example.com
# CARDTRACKER_SMTP_PORT=587
# CARDTRACKER_SMTP_USERNAME=
# CARDTRACKER_SMTP_PASSWORD=
# CARDTRACKER_SMTP_FROM=no-reply@example.com
# CARDTRACKER_SMTP_STARTTLS=true
