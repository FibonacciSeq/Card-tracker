CARDTRACKER_ENVIRONMENT=development
CARDTRACKER_DATABASE_URL=postgresql+psycopg://cardtracker_app:cardtracker_app@db:5432/cardtracker
# Owner role for Alembic only; the runtime URLs above must be non-owner so RLS applies.
CARDTRACKER_MIGRATION_DATABASE_URL=postgresql+psycopg://cardtracker_owner:cardtracker_owner@db:5432/cardtracker
CARDTRACKER_JWT_SECRET=replace-with-at-least-32-random-characters
CARDTRACKER_AUTO_CREATE_TABLES=false
CARDTRACKER_DEFAULT_HOLD_HOURS=24
# Optional customer OTP accounts. The email sender uses the notification backend
# below; the console backend only logs the subject, so use the development-only
# debug code or configure SMTP to test sign-in locally.
# CARDTRACKER_CUSTOMER_ACCESS_TOKEN_MINUTES=720
# CARDTRACKER_OTP_EXPIRY_SECONDS=600
# CARDTRACKER_OTP_RESEND_SECONDS=60
# CARDTRACKER_OTP_MAX_ATTEMPTS=5
# CARDTRACKER_OTP_REQUEST_IP_LIMIT=10
# CARDTRACKER_OTP_REQUEST_IP_WINDOW_SECONDS=3600
# CARDTRACKER_OTP_REQUEST_EMAIL_LIMIT=5
# CARDTRACKER_OTP_REQUEST_EMAIL_WINDOW_SECONDS=900
# CARDTRACKER_OTP_VERIFY_IP_LIMIT=20
# CARDTRACKER_OTP_VERIFY_IP_WINDOW_SECONDS=900
# CARDTRACKER_OTP_VERIFY_EMAIL_LIMIT=10
# CARDTRACKER_OTP_VERIFY_EMAIL_WINDOW_SECONDS=900
# CARDTRACKER_OTP_EMAIL_MAX_ATTEMPTS=5
# Optional dedicated OTP HMAC key; falls back to CARDTRACKER_JWT_SECRET.
# CARDTRACKER_OTP_SECRET=
# Development/test only. Never enable in production.
# CARDTRACKER_OTP_DEBUG_CODE=false
CARDTRACKER_CORS_ORIGINS=*
# Public API origin used in customer emails (restock unsubscribe pages).
CARDTRACKER_PUBLIC_API_URL=http://localhost:8000
# Optional dedicated HMAC key for signed unsubscribe links (defaults to JWT secret).
# CARDTRACKER_UNSUBSCRIBE_SECRET=
# Notification delivery: console (redacted subject only, default), smtp, or none.
# `none` leaves queued mail pending; it does not mark messages as sent.
CARDTRACKER_NOTIFICATION_BACKEND=console
CARDTRACKER_NOTIFICATION_MAX_ATTEMPTS=8
# Required when CARDTRACKER_NOTIFICATION_BACKEND=smtp
# CARDTRACKER_SMTP_HOST=smtp.example.com
# CARDTRACKER_SMTP_PORT=587
# CARDTRACKER_SMTP_USERNAME=
# CARDTRACKER_SMTP_PASSWORD=
# CARDTRACKER_SMTP_FROM=no-reply@example.com
# CARDTRACKER_SMTP_STARTTLS=true
