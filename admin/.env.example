# The admin talks to the API on the same origin by default (Vite proxies /v1
# to 127.0.0.1:8000 in development, Caddy serves it in production).
# Set this only when the API lives on another host.
VITE_API_BASE_URL=

# Public app origin used in settings deep links and QR codes. Prefer
# VITE_PUBLIC_APP_BASE_URL; VITE_APP_BASE_URL is kept as a legacy alias.
VITE_PUBLIC_APP_BASE_URL=
VITE_APP_BASE_URL=

# Store links shown on the settings page (optional).
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
