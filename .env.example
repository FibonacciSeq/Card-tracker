# Copy to .env and fill in locally. Never commit the real file.
#
# The application does not load .env automatically. Export the values in your
# shell before starting the SQL Server tools, for example:
#
#   set -a
#   . ./.env
#   set +a
#
# The local owner/customer apps only need CARDTRACKER_SHOP_DB when the shop
# database lives somewhere other than ./cardtracker_shop.db.

# Local shop database (SQLite)
# CARDTRACKER_SHOP_DB=./cardtracker_shop.db

# SQL Server connection
CARDTRACKER_MSSQL_HOST=localhost
CARDTRACKER_MSSQL_PORT=1433
CARDTRACKER_MSSQL_DATABASE=CardTracker
CARDTRACKER_MSSQL_USER=cardtracker_app
CARDTRACKER_MSSQL_PASSWORD=replace-me
CARDTRACKER_MSSQL_TRUSTED=0
CARDTRACKER_MSSQL_ENCRYPT=1
# Set to 0 in production and use a certificate the client trusts.
CARDTRACKER_MSSQL_TRUST_CERT=1
# CARDTRACKER_MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# CARDTRACKER_MSSQL_DRIVER=pyodbc

# Spreadsheet drop folder for tools.etl_stock
CARDTRACKER_DROP_FOLDER=drop
